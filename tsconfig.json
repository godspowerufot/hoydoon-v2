{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/components/layouts/navbar.jsx",
    "store/slices/api/authapi.js",
    "app/auth/sign-up/page.jsx",
    "app/components/layouts/modals/property.tsx",
    "app/components/common/property.tsx",
    "app/page.jsx",
    "app/components/layouts/profilecard.jsx",
    "app/agent/page.jsx",
    "app/agent/all-agent/page.jsx",
    "app/agent/[id]/page.jsx",
    "app/rent/fixes/page.jsx",
    "pages/api/assetlinks.jss",
    "app/components/layouts/contactagent.jsx",
    "app/components/common/searchcomponent.jsx",
    "app/components/common/profilecard.jsx",
    "app/rent/[id]/page.jsx",
    "app/sell/page.jsx",
    "auth.js",
    "app/api/auth/[...nextauth].js/route.js",
    "pages/api/submit-request.js",
    "app/auth/forgot-password/otp/otp.jsx",
    "app/components/about/page.jsx",
    "app/review/page.jsx",
    "app/search/page.jsx"
  ],
  "exclude": ["node_modules"]
}
